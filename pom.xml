<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>card-game</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <junit.version>5.10.2</junit.version>
        <main.class>org.example.card.ui.Main</main.class>
    </properties>

    <dependencies>
        <!-- JavaFX 界面（游戏王类卡牌 UI：棋盘、卡牌、拖拽、动画） -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- 仅用于诊断截图（scene.snapshot -> PNG） -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JUnit5：锁卡牌规则引擎逻辑（抽卡/召唤/战斗/AI选牌） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- mvn javafx:run 启动桌面窗口（自动处理各平台 native 库） -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <!-- 把 JavaFX 缓存指到临时目录：默认的 ~/.openjfx 在受限环境下写不进去，
                             会导致 native 库/字体缓存初始化异常 -->
                        <option>-Djavafx.cachedir=${project.build.directory}/openjfx-cache</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
